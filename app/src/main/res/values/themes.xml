<?xml version="1.0" encoding="utf-8"?>
<resources>


    <style name="Theme.Mobile_final" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.Mobile_final.Dark" parent="android:Theme.Material.NoActionBar" />
    <!-- Тема для Splash Screen -->
    <style name="Theme.Mobile_final.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_screen_background</item>
